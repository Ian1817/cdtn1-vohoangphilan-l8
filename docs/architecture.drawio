        </mxCell>
        <mxCell id="m2" value="M2: Báo cáo CSAT theo KTV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="client_layer">
          <mxGeometry x="380" y="35" width="240" height="40" as="geometry" />
