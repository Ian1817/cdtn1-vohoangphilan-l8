          <mxGeometry x="720" y="35" width="240" height="40" as="geometry" />
        </mxCell>

        <!-- 2. BACKEND LAYER -->
        <mxCell id="backend_boundary" value="Backend Layer (Node.js / Express - Layered Architecture)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=25;fillColor=#f8f9fa;strokeColor=#495057;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="1000" height="380" as="geometry" />
        </mxCell>
        <mxCell id="controller_layer" value="Routing &amp; Controller Layer (Xác thực HTTP, nhận Request, gọi Service)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="backend_boundary">
          <mxGeometry x="40" y="40" width="920" height="45" as="geometry" />
        </mxCell>
        <mxCell id="service_layer" value="Service Layer (Business Logic: Kiểm tra điều kiện QT-10, chống gửi trùng lặp, tính điểm CSAT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="backend_boundary">
