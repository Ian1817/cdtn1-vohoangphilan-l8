  <diagram id="arch-l8" name="Architecture Luong L8">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 1. CLIENT LAYER -->
        <mxCell id="client_layer" value="Client Layer (Browser / Mobile Web - Frontend)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1000" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="M1: Form Khảo sát CSAT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="client_layer">
